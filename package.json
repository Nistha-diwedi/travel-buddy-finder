{
  "name": "travel-buddy-finder",
  "version": "1.0.0",
  "private": true,
  "description": "Find people to travel with — Cloudflare Worker + D1 backend with a static frontend.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create travel-buddy-db",
    "db:migrate": "wrangler d1 migrations apply travel-buddy-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply travel-buddy-db --local"
  },
  "devDependencies": {
    "wrangler": "^4.20.0"
  }
}
